# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key
# Credentials per środowisko (`credentials:edit --environment development`) trzymają
# klucz w podkatalogu, którego wzorzec wyżej nie łapie — bez tej linijki klucz
# deszyfrujący wchodzi do `git status` jako plik do zacommitowania.
/config/credentials/*.key

.gstack/

# Katalog roboczy subagent-driven-development — artefakty sesji, nie kod.
.superpowers/

# Wewnętrzne dokumenty robocze — nie dla publicznego repo.
/PROGRESS.md
/docs/superpowers/

# Configi Claude per maszyna (wzór: config/claude_configs.example.yml).
/config/claude_configs.yml
