<%= turbo_stream_from @project, :reviews %>
<div class="nav-back"><%= link_to "← wszystkie projekty", projects_path %></div>
<div class="pagehead">
  <h1>Review — <%= @project.name %></h1>
  <p class="summary">
    <span class="pill pill-attention"><b><%= @status_counts.slice(*Review::ATTENTION_STATUSES).values.sum %></b> czeka na Ciebie</span>
    <span class="pill pill-progress"><b><%= @status_counts.slice(*Review::IN_PROGRESS_STATUSES).values.sum %></b> w toku</span>
    <span class="pill"><b><%= @status_counts.values.sum %></b> łącznie</span>
  </p>
</div>
<% if @project.archived? %>
  <%# Przycisk „+ Nowy review" po prostu znika bez wyjaśnienia — a jedyna inna droga
      do przywrócenia projektu to /projects i przewinięcie do „Zarchiwizowane". %>
  <div class="archived-notice">
    <span>Projekt jest zarchiwizowany — nie można dodawać nowych review. Historia poniżej zostaje dostępna.</span>
    <%= button_to "Przywróć projekt", unarchive_project_path(@project), class: "btn" %>
  </div>
<% end %>
<%# Jeden pasek: akcja główna po lewej, reszta drobniejsza obok, filtr po prawej.
    Wcześniej każdy button_to (blokowy <form>) zjeżdżał do osobnej linii. %>
<div class="toolbar project-links">
  <%= link_to "+ Nowy review", new_project_review_path(@project), class: "btn btn-primary" unless @project.archived? %>
  <%= link_to "Edytuj projekt", edit_project_path(@project), class: "btn btn-small" %>
  <%# Dostępny też w archiwum: nowych review nie ma, ale PR-y istniejących dalej się mergują. %>
  <%= button_to "🔄 Sprawdź GitHub teraz", recheck_github_project_reviews_path(@project), class: "btn btn-small" %>
  <% if @project.repo_url.present? %>
    <%= link_to "repo na GitHubie ↗", @project.repo_url, class: "btn btn-small" %>
  <% end %>
  <form method="get" class="filter">
    <select name="status" onchange="this.form.submit()">
      <option value="">Wszystkie statusy</option>
      <% Review::STATUSES.each do |s| %>
        <option value="<%= s %>" <%= "selected" if params[:status] == s %>><%= review_status_label(Review.new(status: s)) %><%= " (#{@status_counts[s]})" if @status_counts[s] %></option>
      <% end %>
    </select>
  </form>
</div>
<table id="reviews">
  <thead>
    <tr>
      <th><%= review_sort_link(@project, "Data", "created_at") %></th>
      <%# Kiedy ostatnio coś się z tym review działo — review sprzed tygodnia, do którego
          wróciłem dziś followupem, na samej dacie utworzenia wygląda jak porzucony. %>
      <th><%= review_sort_link(@project, "Aktywność", "updated_at") %></th>
      <%# Ostatni ruch na samym PR-ze (updatedAt z GitHuba) — obok „Aktywności"
          dashboardu, żeby jednym rzutem oka porównać „ja vs oni". %>
      <th><%= review_sort_link(@project, "Ruch na PR", "pr_activity_at") %></th>
      <th>PR / zadanie</th>
      <th><%= review_sort_link(@project, "Status", "status") %></th>
      <th><%= review_sort_link(@project, "Decyzja", "decided_at") %></th>
      <%# Nie sortowalne: istnienie katalogu to odczyt z dysku, a nie kolumna w bazie. %>
      <th>Worktree</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "review_row", collection: @reviews, as: :review,
               locals: { running_ids: @running_review_ids, verifying_ids: @verifying_review_ids } %>
  </tbody>
</table>
<%# Pusta tabela bez słowa wygląda jak zepsuta strona, a najczęstszą przyczyną jest
    filtr statusu, o którym łatwo zapomnieć. %>
<% if @reviews.empty? %>
  <p class="empty">
    <% if params[:status].present? %>
      Żadne review nie ma statusu „<%= params[:status] %>".
      <%= link_to "Pokaż wszystkie", project_reviews_path(@project) %>
    <% else %>
      Jeszcze żadnego review w tym projekcie. Zacznij od „+ Nowy review".
    <% end %>
  </p>
<% end %>
