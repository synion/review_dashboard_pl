<% findings_by_priority = review.findings.order(:priority).group_by(&:priority) %>
<% fix_summary = review.fix_summary %>
<% verdict_summary = review.verdict_summary %>
<div class="card">
  <h2>Znaleziska (<%= findings_by_priority.values.sum(&:size) %>)</h2>
  <% if review.findings_verification_in_progress? %>
    <p>⚖️ Weryfikuję zasadność uwag świeżą sesją…</p>
    <div id="review_<%= review.id %>_side_progress"><%= render "reviews/verify_findings_progress", review: review %></div>
  <% elsif review.findings_verifiable? %>
    <%# Świeża sesja, bez kontekstu review — kontra dla sesji broniącej własnych
        ustaleń. W odróżnieniu od „czy uwagi wdrożone" pyta, czy w ogóle były słuszne. %>
    <button type="button" class="btn" onclick="document.getElementById('verify_findings_dialog').showModal()">
      ⚖️ Zweryfikuj zasadność uwag (świeża sesja)
    </button>
    <p class="muted">
      <%= review.findings_verified_at ? "zweryfikowane #{l review.findings_verified_at, format: :short}" : "jeszcze nie weryfikowane" %>
      — druga opinia bez kontekstu sesji, która te uwagi znalazła
    </p>
    <%= render "reviews/verify_findings_modal", review: review %>
  <% end %>
  <% if verdict_summary.any? %>
    <p class="muted">Weryfikacja zasadności:
      <%= Finding::VERDICT_LABELS.filter_map { |verdict, label| "#{verdict_summary[verdict]} #{label}" if verdict_summary[verdict] }.join(" · ") %>
    </p>
  <% end %>
  <% if fix_summary.any? %>
    <p class="muted">Po poprawkach autora:
      <%= Finding::FIX_LABELS.filter_map { |status, label| "#{fix_summary[status]} #{label}" if fix_summary[status] }.join(" · ") %>
    </p>
  <% end %>
  <% Finding::PRIORITY_LABELS.each do |priority, label| %>
    <% findings = findings_by_priority[priority] %>
    <% next if findings.blank? %>
    <h3><%= label %> (<%= findings.size %>)</h3>
    <% findings.each do |f| %>
      <%# Obalone tylko wyszarzamy, bez chowania — werdykt to opinia drugiej
          sesji, ostateczna decyzja należy do człowieka. %>
      <div class="finding finding-<%= f.priority %><%= " finding-refuted" if f.refuted? %>">
        <strong><%= f.title %></strong>
        <% if f.verdict.present? %>
          <span class="status-badge verdict-<%= f.verdict %>" title="<%= f.verdict_note %>"><%= f.verdict_label %></span>
        <% end %>
        <% if f.fix_status.present? %>
          <span class="status-badge fix-<%= f.fix_status %>" title="<%= f.fix_note %>"><%= f.fix_label %></span>
        <% end %>
        <% if f.file_location.present? %><code class="inline"><%= f.file_location %></code><% end %>
        <details><summary>szczegóły</summary><%= markdown f.body %></details>
      </div>
    <% end %>
  <% end %>
  <% if findings_by_priority.empty? %><p>Brak znalezisk 🎉</p><% end %>
</div>
