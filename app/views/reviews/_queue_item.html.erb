<%# Kafel kolejki na stronie wejściowej. Kolejność informacji jest celowa:
    najpierw stan i jak długo stoi, potem CO to jest, na końcu następny ruch —
    tak, żeby przelot wzrokiem po lewej krawędzi wystarczał do wyboru pracy. %>
<article class="qitem q-<%= review.status %>" id="review_queue_<%= review.id %>">
  <div class="qtop">
    <span class="status-badge status-<%= review.status %>"><%= review_status_label(review) %></span>
    <%= link_to review.project.name, project_reviews_path(review.project), class: "qproj" %>
    <span class="qwait" title="ostatnia aktywność: <%= review_last_activity(review) %>">
      <%= review.status.in?(Review::ATTENTION_STATUSES) ? "czeka" : "od" %> <%= review_waiting_for(review) %>
    </span>
    <% if review.status == "reviewing" && running_ids.exclude?(review.id) %>
      <span class="queued-hint">⏳ Czeka w kolejce workera</span>
    <% end %>
  </div>
  <%= link_to (review.pr_title.presence || review.task_link || "review ##{review.id}"),
              review_path(review), class: "qttl" %>
  <div class="qact"><%= review_next_step(review) %></div>
  <div class="qmeta">
    <%= [ review_findings_summary(review),
          review.pr_number ? "PR ##{review.pr_number}" : nil,
          review.branch.presence,
          review.model.presence,
          review.effort.presence ].compact.join(" · ") %>
  </div>
</article>
