<div class="form-page">
<div class="nav-back"><%= link_to "← review projektu #{@project.name}", project_reviews_path(@project) %></div>
<div class="pagehead">
  <h1>Nowy review — <%= @project.name %></h1>
</div>
<div class="card form-card">
  <%= form_with model: [ @project, @review ] do |f| %>
    <%# Trzy pola źródła to trzy TRYBY review — bez tego nagłówka formularz wygląda,
        jakby wszystkie trzy trzeba było wypełnić. %>
    <h2 class="form-section">Co mam przejrzeć? <span class="form-section-note">wystarczy jedno z trzech</span></h2>
    <div class="field">
      <%= f.label :pr_url, "Link do PR na GitHubie" %>
      <%# Ze slugu, nie z surowego repo_url: adres zakończony ukośnikiem albo .git
          (oba przechodzą walidację Project) sklejony wprost dałby "//pull/…" albo
          ".git/pull/…". %>
      <%= f.url_field :pr_url, placeholder: "https://github.com/#{@project.github_slug.presence || "…"}/pull/…" %>
      <span class="hint">Pełny review: checkout PR-a, a decyzja i komentarze wracają na GitHuba.</span>
    </div>
    <div class="field">
      <%= f.label :task_url, "Link do zadania" %>
      <%= f.url_field :task_url, placeholder: "https://…" %>
      <span class="hint">Przy PR-ze wypełnia się sam z jego opisu. Sam link = review zmian opisanych w zadaniu.</span>
    </div>
    <div class="field">
      <%= f.label :branch, "Branch" %>
      <%# Datalist, nie select: wybór z istniejących worktree jednym klikiem,
          a wpisanie brancha, którego worktree dopiero powstanie, dalej działa. %>
      <%= f.text_field :branch, list: "worktree_branches",
                       placeholder: @worktree_branches.any? ? "wybierz worktree albo wpisz branch" : nil %>
      <datalist id="worktree_branches">
        <% @worktree_branches.each do |branch| %>
          <option value="<%= branch %>"></option>
        <% end %>
      </datalist>
      <span class="hint">Sam branch = selfreview własnych zmian przed wystawieniem PR-a
        (diff do gałęzi głównej; nie wchodzi do kolejek na stronie wejściowej).</span>
    </div>

    <%# Sesja to sprawy drugorzędne — defaulty przychodzą z ustawień projektu,
        więc trzy selecty stoją w jednym rzędzie zamiast puchnąć w pionie. %>
    <h2 class="form-section">Sesja Claude <span class="form-section-note">domyślne z ustawień projektu</span></h2>
    <div class="form-grid">
      <div class="field">
        <%= f.label :claude_config, "Config" %>
        <%= f.select :claude_config, Review::CLAUDE_CONFIGS %>
      </div>
      <div class="field">
        <%= f.label :model, "Model" %>
        <%= f.select :model, [ [ "domyślny (z configu)", "" ] ] + Review::MODELS.map { |m| [ m, m ] } %>
      </div>
      <div class="field">
        <%= f.label :effort, "Effort" %>
        <%= f.select :effort, [ [ "domyślny", "" ] ] + Review::EFFORTS.map { |e| [ e, e ] } %>
      </div>
    </div>
    <div class="field">
      <label class="checkbox-label"><%= check_box_tag :fetch_task_description, "1", true %>
        📋 Pobierz opis zadania (z linku do zadania albo z opisu PR-a)</label>
    </div>
    <%= f.submit "Dalej → opisz mi to zadanie", class: "btn btn-primary btn-big" %>
  <% end %>
</div>
</div>
