<%= turbo_stream_from @review %>
<p><%= link_to "← wróć do listy", project_reviews_path(@review.project) %></p>
<h1><%= @review.pr_title.presence || "Review ##{@review.id}" %></h1>
<p>
  <% if @review.pr_url.present? %><%= link_to @review.pr_url, @review.pr_url, target: "_blank" %><% end %>
  <% if @review.task_url.present? %><%= link_to @review.task_url, @review.task_url, target: "_blank" %><% end %>
</p>
<div id="review_<%= @review.id %>_panel">
  <%= render "reviews/panel", review: @review %>
</div>
