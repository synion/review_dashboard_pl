<!DOCTYPE html>
<%# Bez lang przeglądarka zgaduje język strony (polsko-angielska mieszanka
    techniczna) i potrafi włączyć autotłumaczenie całego dashboardu. %>
<html lang="pl">
  <head>
    <title><%= content_for(:title) || "Review Dashboard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Review Dashboard">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Motyw z localStorage przed pierwszym malowaniem — bez tego strona miga
        systemowym motywem, zanim Stimulus zdąży wystartować. %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        var theme = localStorage.getItem("theme");
        if (theme) document.documentElement.dataset.theme = theme;
      })();
    </script>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <%= link_to "Review Dashboard", root_path, class: "brand" %>
      <span class="topbar-actions">
        <%# Etykieta pokazuje AKTUALNY tryb (jak „Motyw:" obok), a kierunek przełączenia
            mówi title — inaczej dwa sąsiadujące przyciski czytałyby się odwrotnie. %>
        <%= button_to split_view? ? "Widok: dwie kolumny" : "Widok: pełne strony",
                      view_mode_path(mode: split_view? ? "classic" : "split"), method: :patch,
                      class: "pill btn-view", form_class: "button_to",
                      title: split_view? ? "Przełącz na pełne strony — kafel otwiera osobną stronę" :
                                           "Przełącz na dwie kolumny — kafel otwiera się w prawym panelu" %>
        <button type="button" class="pill btn-theme" data-controller="theme" data-action="theme#toggle">Motyw:</button>
      </span>
    </header>
    <% flash.each do |kind, message| %>
      <div class="flash flash-<%= kind %>"><%= message %></div>
    <% end %>
    <%# Strona wejściowa jest dwukolumnowa (lista po lewej, szczegóły po prawej) i
        w 960 px się nie mieści — szerokość zamawia sam widok przez :container_class. %>
    <main class="container <%= content_for(:container_class) %>"><%= yield %></main>
  </body>
</html>
