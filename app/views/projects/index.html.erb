<%# Strona wejściowa odpowiada na jedno pytanie: co teraz kliknąć. Kolejki review
    są więc PONAD listą projektów — projekty to nawigacja, a nie praca.

    Dwa układy do wyboru (przełącznik w topbarze, patrz ViewModeHelper):
    „split" trzyma wybór pracy po lewej, a szczegóły w ramce #detail po prawej —
    bez tego każdy klik w kafel gubił listę i wracało się do niej „wstecz".
    „classic" to jedna kolumna i pełne podstrony, dla kogoś, kto woli stary układ. %>
<% content_for :container_class, "container-wide" if split_view? %>
<%# Tytuł karty = licznik pracy (czeka / do dokończenia / w toku). Tu dla pierwszego
    renderu, dalej pilnuje go page_title_controller — patrz dashboard_title. %>
<% content_for :title, dashboard_title(@dashboard) %>
<%# Kolejki zmieniają się bez udziału tej karty: PR-y wpadają z odświeżenia GitHuba
    w tle, review przechodzą do „W toku" z jobów. Strumień dowozi jedno i drugie —
    patrz BroadcastDashboardJob. %>
<%= turbo_stream_from :dashboard %>
<div class="<%= split_view? ? "dash" : "dash dash-single" %>" data-controller="detail-pane">
  <div class="dash-main">
    <div class="pagehead">
      <h1>Review dashboard</h1>
      <%= render "projects/summary", dashboard: @dashboard %>
    </div>

    <%# Kolejki pokazują wyłącznie projekt główny — przełącza go switcher u góry albo
        radio na karcie projektu; odpowiedź turbo_stream podmienia #summary, #queues
        i #projects. %>
    <%= render "projects/queues", dashboard: @dashboard %>

    <%= render "projects/grid" %>

    <% if @archived_projects.any? %>
      <%# Zwinięte: archiwum jest potrzebne raz na kwartał i nie może wyglądać jak druga,
          równorzędna lista projektów. %>
      <details id="archived_projects">
        <summary>Zarchiwizowane (<%= @archived_projects.size %>)</summary>
        <% @archived_projects.each do |project| %>
          <div class="archrow" id="project_row_<%= project.id %>">
            <%= link_to project.name, project_reviews_path(project), data: { turbo_frame: detail_frame } %>
            <span class="muted"><%= @counts[project.id][:total] %> review</span>
            <%= button_to "Przywróć", unarchive_project_path(project), class: "btn" %>
          </div>
        <% end %>
      </details>
    <% end %>
  </div>

  <% if split_view? %>
    <%# Ramka, nie osobna strona: klik po lewej wymienia TYLKO tę kolumnę, a lista
        pracy zostaje na ekranie. Nawigacja ramki dopisuje się do historii
        (turbo-action="advance"), więc „wstecz" cofa wybór, a nie całą stronę. %>
    <aside class="dash-detail">
      <%= turbo_frame_tag "detail", data: { turbo_action: "advance" } do %>
        <div class="detail-empty">
          <p>Wybierz coś po lewej.</p>
          <p class="muted">Kafel kolejki otworzy tu review, nazwa projektu — jego listę review.</p>
        </div>
      <% end %>
    </aside>
  <% end %>
</div>
