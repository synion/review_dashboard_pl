<%# Przełącznik na górze i radio „główny" na kartach to dwa uchwyty tej samej
    dźwigni — oba POST-ują select, a odpowiedź turbo_stream podmienia #summary,
    #queues i #projects, więc zawsze pokazują ten sam wybór. Liczby biorą się
    z tego samego Dashboard co kolejki, więc broadcast odświeża jedno i drugie. %>
<div id="summary">
  <% if dashboard.projects.many? %>
    <nav class="proj-switcher" aria-label="Projekt główny">
      <% dashboard.projects.each do |project| %>
        <%= button_to project.name, select_projects_path(project_id: project.id),
                      form_class: class_names("button_to", "is-main": project == dashboard.main_project) %>
      <% end %>
    </nav>
  <% end %>
  <p class="summary">
    <% if dashboard.main_project.nil? %>
      <span class="pill"><b>brak projektów</b></span>
    <% elsif dashboard.projects.one? %>
      <span class="pill"><b><%= dashboard.main_project.name %></b></span>
    <% end %>
    <span class="pill pill-attention"><b><%= dashboard.inbox_items.size %></b> czeka na Twoje review</span>
    <span class="pill"><b><%= dashboard.attention_reviews.size %></b> do dokończenia</span>
    <span class="pill pill-progress"><b><%= dashboard.in_progress_reviews.size %></b> w toku</span>
  </p>
</div>
