<div class="card">
  <%= form_with model: project do |f| %>
    <div class="field">
      <%= f.label :name, "Nazwa" %>
      <%= f.text_field :name %>
    </div>
    <div class="field">
      <%= f.label :repo_path, "Ścieżka do repo na dysku" %>
      <%= f.text_field :repo_path, placeholder: "/Users/ja/projekty/moje-repo" %>
    </div>
    <div class="field">
      <%= f.label :repo_url, "Adres repo na GitHubie" %>
      <%= f.url_field :repo_url, placeholder: "https://github.com/owner/repo" %>
      <span class="hint">Po co: PR wklejony z innego repo zostanie odrzucony, zanim powstanie worktree.</span>
    </div>
    <div class="field">
      <%= f.label :task_url_prefix, "Prefiks adresu zadania w trackerze" %>
      <%= f.text_field :task_url_prefix, placeholder: "https://tracker.example.com/organize/tasks/" %>
      <span class="hint">Po co: link do zadania jest wyłuskiwany z opisu PR-a i wpisywany
        do formularza review. Puste = przepisujesz go ręcznie.</span>
    </div>
    <div class="field">
      <%= f.label :default_claude_config, "Domyślny config Claude" %>
      <%= f.select :default_claude_config, Review::CLAUDE_CONFIGS %>
    </div>
    <div class="field">
      <%= f.label :default_model, "Domyślny model" %>
      <%= f.select :default_model, [ [ "domyślny (z configu)", "" ] ] + Review::MODELS.map { |m| [ m, m ] } %>
    </div>
    <div class="field">
      <%= f.label :default_effort, "Domyślny effort" %>
      <%= f.select :default_effort, [ [ "domyślny", "" ] ] + Review::EFFORTS.map { |e| [ e, e ] } %>
    </div>
    <div class="field">
      <%= f.label :docs_path, "Katalog z dokumentacją dla modeli" %>
      <%= f.text_field :docs_path, placeholder: "doc/llm" %>
      <span class="hint">Trafia do promptu tylko wtedy, gdy katalog realnie istnieje w repo.</span>
    </div>
    <div class="field">
      <%= f.label :review_prompt_extra, "Stałe zasady review w tym projekcie" %>
      <%= f.text_area :review_prompt_extra, rows: 6 %>
      <span class="hint">Doklejane do każdego promptu review w tym projekcie.</span>
    </div>
    <div class="field">
      <%= f.label :task_comment_instructions, "Instrukcja komentarza do zadania po decyzji" %>
      <%= f.text_area :task_comment_instructions, rows: 4 %>
      <span class="hint">Default dla checkboxa „Dodaj komentarz do zadania" przy decyzji — tam da się ją jednorazowo nadpisać.</span>
    </div>
    <%# Akcje po decyzji: defaults comboboxów w panelu. Odśwież dotyczy całego
        cache list (collaboratorzy + labelki), więc siedzi przy nagłówku sekcji,
        nie w hincie jednego pola. Combobox wymaga zapisanego projektu (endpoint
        directory) — przy tworzeniu zwykłe pole tekstowe. %>
    <h3>Akcje po decyzji
      <% if project.persisted? %>
        <%= link_to "↻ Odśwież listy podpowiedzi", refresh_directory_project_path(project),
              class: "hint", data: { turbo_method: :post } %>
      <% end %>
    </h3>
    <div class="field">
      <%= f.label :second_reviewer_default, "Domyślny drugi reviewer (login z GitHuba)" %>
      <% if project.persisted? %>
        <%= render "shared/combobox", project: project, kind: "gh_collaborator",
              field_name: "project[second_reviewer_default]", initial: project.second_reviewer_default %>
      <% else %>
        <%= f.text_field :second_reviewer_default, placeholder: "login-wspolpracownika" %>
      <% end %>
      <span class="hint">Prefill comboboxa „Dodaj reviewera po decyzji", gdy PR-a nikt wcześniej nie reviewował.</span>
    </div>
    <div class="field">
      <%= f.label :approve_label_default, "Domyślny label po decyzji" %>
      <% if project.persisted? %>
        <%= render "shared/combobox", project: project, kind: "gh_label",
              field_name: "project[approve_label_default]", initial: project.approve_label_default %>
      <% else %>
        <%= f.text_field :approve_label_default, placeholder: "np. after-review" %>
      <% end %>
      <span class="hint">Prefill comboboxa „Dodaj label po decyzji", gdy ktoś już reviewował PR-a.</span>
    </div>
    <div class="field">
      <%= f.label :worktree_command, "Komenda tworząca worktree" %>
      <%= f.text_field :worktree_command, placeholder: "bin/worktree-docker %{branch}" %>
      <span class="hint">Uruchamiana w katalogu repo. <code>%{branch}</code> zostanie podmienione na nazwę brancha.</span>
    </div>
    <div class="field">
      <%= f.label :worktree_delete_command, "Komenda usuwająca worktree" %>
      <%= f.text_field :worktree_delete_command, placeholder: "bin/worktree-docker -d %{branch} --force" %>
      <span class="hint">Bez niej dashboard nie pokaże przycisku „Usuń worktree".</span>
    </div>
    <%= f.submit class: "btn btn-primary btn-big" %>
  <% end %>
</div>
