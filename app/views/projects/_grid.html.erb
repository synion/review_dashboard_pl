<%# Sekcja jest celem turbo_stream po przełączeniu projektu głównego, bo radio
    „główny" na karcie musi zsynchronizować się z przełącznikiem u góry strony
    (dwa uchwyty tej samej dźwigni — patrz _summary). %>
<section id="projects">
  <h2>Projekty</h2>
  <%# Pusty form dla radiów „główny": radia na kartach wskazują go atrybutem form=,
      dzięki czemu tworzą JEDNĄ natywną grupę (stare radio odznacza się samo), choć
      karty mają własne formy button_to — zagnieżdżenie formów byłoby nielegalne. %>
  <%= form_with url: select_projects_path, id: "main-switcher" do %><% end %>
  <div class="projgrid">
    <% @projects.each do |project| %>
      <% counts = @counts[project.id] %>
      <article class="projcard" id="project_row_<%= project.id %>">
        <h3>
          <%= link_to project.name, project_reviews_path(project) %>
          <label class="main-radio" title="Pokazuj kolejki tego projektu na tej stronie">
            <%= radio_button_tag :project_id, project.id, project == @main_project,
                                 form: "main-switcher", onchange: "this.form.requestSubmit()" %>
            główny
          </label>
        </h3>
        <%# Zero to brak pracy — pełnym kontrastem konkurowało z liczbą, która akcji
            wymaga, więc puste licznik ściszamy. %>
        <div class="counts">
          <span class="count<%= counts[:attention].positive? ? " count-hot" : " count-zero" %>">
            <b data-count="attention"><%= counts[:attention] %></b> czeka
          </span>
          <span class="count<%= " count-zero" if counts[:in_progress].zero? %>"><b data-count="in_progress"><%= counts[:in_progress] %></b> w toku</span>
          <span class="count<%= " count-zero" if counts[:total].zero? %>"><b data-count="total"><%= counts[:total] %></b> łącznie</span>
        </div>
        <%# Jedna akcja główna na kartę; „Wszystkie review" to ta sama nawigacja co
            klik w nazwę projektu, więc zostaje cichym linkiem. %>
        <div class="project-links projcard-actions">
          <%= link_to "+ Nowy review", new_project_review_path(project), class: "btn btn-primary btn-small" %>
          <%= link_to "Wszystkie review", project_reviews_path(project), class: "link-quiet" %>
        </div>
        <div class="projmeta">
          <%# Ścieżka w jednej linii z ellipsis: z `word-break: break-all` łamała się na
              trzy wiersze i była największym elementem karty, choć czyta się ją raz. %>
          <code class="inline projpath" title="<%= project.repo_path %>"><%= project_path_label(project) %></code>
          <% if (config = [ project.default_model.presence, project.default_effort.presence ].compact.join(" / ")).present? %>
            <span class="projconfig"><%= config %></span>
          <% end %>
        </div>
        <div class="projadmin">
          <%= link_to "Edytuj", edit_project_path(project) %>
          <%= button_to "Archiwizuj", archive_project_path(project),
                form: { data: { turbo_confirm: "Zarchiwizować projekt #{project.name}? Zniknie z listy aktywnych, ale będzie można go przywrócić." } } %>
        </div>
      </article>
    <% end %>
    <%# Kafel „dodaj" siedzi w gridzie, a nie jako przycisk pod nim: dodanie projektu
        robi się raz i nie może wyglądać jak akcja równorzędna z „+ Nowy review". %>
    <%= link_to "+ Nowy projekt", new_project_path, class: "projcard-add" %>
  </div>
</section>
