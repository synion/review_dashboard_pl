# Review Dashboard — zmienne środowiskowe (wszystkie opcjonalne).
#
# UWAGA: Rails NIE ładuje tego pliku automatycznie (brak gema dotenv).
# To ściąga wartości do przekazania w shellu, np.:
#   PORT=3020 GITHUB_REVIEWER_LOGIN=twoj-login bin/dev

# Port serwera (default: 3000).
PORT=3000

# Twój login na GitHubie. Zwykle NIEPOTRZEBNE: dashboard bierze login z zalogowanego
# `gh` (`gh api user`). Ustaw tylko, gdy `gh` jest zalogowane na inne konto.
GITHUB_REVIEWER_LOGIN=twoj-login-github

# Odświeżanie kolejki „czeka na Twoje review" w tle (harmonogram co 1 h).
# Domyślnie WYŁĄCZONE: bez tej flagi dashboard pyta GitHuba tylko wtedy, gdy wejdziesz
# na stronę albo klikniesz „Sprawdź teraz". Włącz, gdy apka ma chodzić w tle.
INBOX_SCHEDULE=1

# Workery solid_queue w procesie Pumy. `bin/dev` ustawia to samo — ustawiaj
# ręcznie tylko, gdy startujesz przez `bin/rails server`.
SOLID_QUEUE_IN_PUMA=1

# Liczba procesów workerów jobów (default: 1).
JOB_CONCURRENCY=1

# Wątki w procesie workera (default: 6) — ile jobów, w tym sesji Claude, idzie naraz.
JOB_THREADS=6

# Hasło do dashboardu wystawionego przez tunel cloudflared (*.trycloudflare.com).
# Tylko dev, tylko ruch z tunelu — localhost zostaje bez hasła. Bez tej zmiennej
# host tunelu nie jest wpuszczany.
# TUNNEL_PASSWORD=

# Pula połączeń do SQLite (default: 5).
RAILS_MAX_THREADS=5
